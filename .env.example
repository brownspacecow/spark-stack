# Copy to .env and fill in. Never commit .env.

# Pin a GB10/sm_121-compatible vLLM image. This tag appeared in a community build for the Spark;
# alternatives: NVIDIA's NGC vLLM image, or eugr/spark-vllm-docker. Check which is newest.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0

# Any vLLM-compatible Hugging Face model. MoE / NVFP4 models suit the Spark best.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
SERVED_NAME=nemotron-3.5-super-vl
DRAFT_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
HF_TOKEN=go-get-one-from-huggingface
GPU_MEM_UTIL=0.75
MAX_MODEL_LEN=114688
MAX_NUM_SEQS=1
TOOL_PARSER=qwen3_coder
REASONING_PARSER=nemotron_v3

PG_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
GRAFANA_PASSWORD=change-me

# --- New required secrets ---------------------------------------------------
# Encrypts stored credentials in Postgres. Set once; do not change later.
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_SALT_KEY=

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
# Public hostname service URL must be: http://edge-proxy:8080
CF_TUNNEL_TOKEN=

# --- Port binding -----------------------------------------------------------
# Loopback only by default. Use the Spark's LAN IP (e.g. 192.168.1.50) if other
# machines on your LAN talk to LiteLLM/Grafana directly. Never 0.0.0.0
# (Docker-published ports bypass ufw).
LITELLM_BIND=127.0.0.1
GRAFANA_BIND=127.0.0.1

# --- Image pins -------------------------------------------------------------
# CHANGE THESE. The defaults below keep today's behaviour but float. Pin each to
# the exact version you're running now:
#   docker compose images
# or to a digest:
#   docker pull <image> && docker inspect --format '{{index .RepoDigests 0}}' <image>
# Pin Grafana to what you already run: Grafana does not support downgrades.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
PROMETHEUS_IMAGE=prom/prometheus:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
GRAFANA_IMAGE=grafana/grafana:latest
CADDY_IMAGE=caddy:2-alpine
# cloudflared drops support for old releases, so keep this reasonably current.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# --- Optional: vLLM media SSRF protection -----------------------------------
# Only used if you uncomment --allowed-media-domains in docker-compose.yml.
# Comma/space syntax depends on your vLLM version; check `vllm serve --help`.
# ALLOWED_MEDIA_DOMAINS=upload.wikimedia.org

