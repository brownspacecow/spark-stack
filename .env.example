# Copy to .env and fill in. Never commit .env.

# Pin a GB10/sm_121-compatible vLLM image. This tag appeared in a community build for the Spark;
# alternatives: NVIDIA's NGC vLLM image, or eugr/spark-vllm-docker. Check which is newest.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0

# Any vLLM-compatible Hugging Face model. MoE / NVFP4 models suit the Spark best.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
SERVED_NAME=nemotron-3.5-super-vl
DRAFT_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
HF_TOKEN=go-get-one-from-huggingface
GPU_MEM_UTIL=0.75
MAX_MODEL_LEN=114688
MAX_NUM_SEQS=1
TOOL_PARSER=qwen3_coder
REASONING_PARSER=nemotron_v3

PG_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
GRAFANA_PASSWORD=change-me
